# ─── PostgreSQL ───────────────────────────────────────────────────────────────
# Option 1 — full connection string
DATABASE_URL=postgresql://user:password@localhost:5432/brainforge

# Option 2 — individual fields (used when DATABASE_URL is not set)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=brainforge
# DB_USER=postgres
# DB_PASSWORD=your_password

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET=your-very-strong-secret-at-least-32-chars
# Access-token lifetime. The frontend refreshes on 401, so a short value is fine.
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=another-very-strong-secret-at-least-32-chars
JWT_REFRESH_EXPIRES_IN=7d

# ─── AI Services ──────────────────────────────────────────────────────────────
# REQUIRED for the assistant and every AI feature. Pick ONE provider.
#
# Option A — OpenRouter (used by default).
#   Note: the server must be able to reach openrouter.ai. From an Iranian
#   datacenter it usually cannot, in which case use Option B.
OPENROUTER_API_KEY=sk-or-v1-...

# Option B — Liara AI (OpenAI-compatible, reachable from Iran). Takes priority
#   over OPENROUTER_API_KEY when both the key and the base URL are set.
# LIARA_AI_API_KEY=your-liara-ai-key
# LIARA_AI_BASE_URL=https://ai.liara.ir/api/v1/<service-id>/openai/v1
# LIARA_AI_MODEL=openai/gpt-4o-mini      # optional: force a single model

# Optional — override the model chain without redeploying, comma separated.
# Tool/function-calling routes (the assistant) need tool-capable models.
# AI_MODELS_TOOLS=openai/gpt-oss-120b:free,openai/gpt-4o-mini
# AI_MODELS_TEXT=openai/gpt-oss-120b:free,openai/gpt-4o-mini
# AI_TIMEOUT_MS=30000                    # per model attempt
# AI_TIMEOUT_LONG_MS=60000               # idea analysis

# Speech-to-text (voice input) calls api.openai.com directly and needs its own
# key. Same reachability caveat as OpenRouter above.
OPENAI_API_KEY=sk-...
# SPEECH_TO_TEXT_BASE_URL=https://api.openai.com/v1   # point at a reachable OpenAI-compatible endpoint

# Only used if you re-enable the legacy Perplexity path.
PERPLEXITY_API_KEY=your-api-key

# NOTE: LOVABLE_API_KEY is no longer read. A Lovable key sent to OpenRouter
# just produces a 401, which used to surface as "the service is busy".

# ─── Email ────────────────────────────────────────────────────────────────────
RESEND_API_KEY=your-resend-api-key
EMAIL_FROM=noreply@yourdomain.com

# ─── SMS (Ghasedak) ───────────────────────────────────────────────────────────
SMS_API_KEY=your-ghasedak-api-key
SMS_LINE_NUMBER=                        # optional: sender line number
SMS_OTP_TEMPLATE=                       # optional: OTP template name in panel

# ─── Telegram ─────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_WEBHOOK_SECRET=your-webhook-secret

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production
SITE_URL=https://yourdomain.com
ALLOWED_ORIGINS=http://localhost:5173,https://yourdomain.com

# ─── Admin Bootstrap ──────────────────────────────────────────────────────────
# Bootstrap the first admin: POST /create-admin with this secret
ADMIN_SECRET=your-admin-bootstrap-secret
